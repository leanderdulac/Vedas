# Copie para .env e preencha (não commite segredos)

# PostgreSQL + pgvector (docker compose up -d db)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vedas:vedas@127.0.0.1:5433/vedas
# ou: VEDIC_DATABASE_URL=default

# SpaceXAI / xAI — geração RAG em /ask
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
# Narração de versos (SpaceXAI TTS). orion = narração; eve/ara/leo/rex também.
XAI_TTS_VOICE=orion

# Mídia local (extra pip install -e ".[media]").
# auto = Stable Diffusion se o extra estiver instalado, senão xAI Imagine.
# diffusion = SD-Turbo (imagem; refresh refina o still), SVD (vídeo) e,
# por baixo do TTS, um drone de tanpura do Stable Audio. O modelo de áudio
# não recita o mantra.
# VEDIC_MEDIA_BACKEND=auto
# VEDIC_AUDIO_BED=auto
# Imagem: sem VEDIC_SD_MODEL usa o SDXL-Turbo se estiver no cache, senão o sd-turbo.
# Baixar o SDXL-Turbo (~7 GB, só fp16):
#   HF_HUB_OFFLINE=0 python -c "from huggingface_hub import snapshot_download as d; d('stabilityai/sdxl-turbo', allow_patterns=['*.json','*.txt','*/*.fp16.safetensors'])"
# VEDIC_SD_MODEL=stabilityai/sdxl-turbo
# VEDIC_SD_STEPS=4
# VEDIC_SD_TURBO_GUIDANCE=1.5   # CFG leve: o prompt negativo pesa. 0 = sem CFG.
# VEDIC_SD_SEED=                # fixa o ruído (reprodutível)
# VEDIC_SVD_WIDTH=1024          # 768 poupa memória no vídeo
# VEDIC_SVD_MODEL=stabilityai/stable-video-diffusion-img2vid-xt
# VEDIC_AUDIO_MODEL=stabilityai/stable-audio-open-1.0
# No Apple Silicon: VEDIC_DEVICE=mps. Primeiro download: HF_HUB_OFFLINE=0.

# Fallback local (transformers) se não usar xAI
# VEDIC_LOCAL_LM=gpt2

# Operações HTTP de ingestão/treino/índice/DB: desabilitadas sem token.
# Envie Authorization: Bearer <token>. A CLI continua disponível sem token.
VEDIC_PIPELINE_API_TOKEN=

# Índice permitido nos endpoints públicos de busca/chat (default: artifacts/embeddings).
VEDIC_API_INDEX_DIR=artifacts/embeddings
# Geração (/ask xAI ou local) e mídia nova (/audio, /image, /video).
# Não colocar este token em variável VITE_* nem no bundle do frontend.
#
# VEDIC_PUBLIC_API desligado (default, dev e UI local): token vazio deixa a
# chave do servidor autorizar. A UI funciona sem enviar segredo.
# VEDIC_PUBLIC_API=1 (docker-compose.prod.yml): sem este token, /ask pago e
# a geração de mídia respondem 503. Com o token, a requisição precisa do
# Bearer; senão 401. provider=extractive continua aberto. Leitura de mídia
# em cache também.
VEDIC_PUBLIC_API=
VEDIC_GENERATION_API_TOKEN=

# Rate limiting (anti-abuso/DoS) de endpoints públicos dispendiosos (LLM, TTS, Imagine).
# Enabled por padrão; janela fixa de 1 min por (grupo, IP cliente).
VEDIC_RATE_LIMIT_ENABLED=true
VEDIC_RATE_LIMIT_PER_MINUTE=180
# Tetos por grupo: generation<=60, media<=120, metrics<=30 (min com o global acima).
# Confie em X-Forwarded-For apenas atrás de proxy confiável (Caddy).
VEDIC_TRUST_PROXY_HEADERS=true
# Diretórios extras permitidos nas ops de pipeline (/ingest,/tokenize,/train,/build-index,/db/sync).
# Separados por ':'. Default: PROJECT_ROOT + TMPDIR.
# VEDIC_ALLOWED_DATA_DIRS=/mnt/corpus:/srv/vedas
# Teto de download do crawler (bytes). Default 26214400 (25MB).
VEDIC_MAX_DOWNLOAD_BYTES=26214400
# Dimensão vector(N) do pgvector (64..3072). Default 384 (MiniLM multilíngue).
# Troque o modelo → ajuste aqui, rode db-init e build-index --backend pgvector.
VEDIC_EMBEDDING_DIM=384
# Workers da fila de jobs async (/ingest/async, /train/async, ...). 1..4, default 2.
VEDIC_JOB_WORKERS=2
# Persistência dos jobs em disco (default data/jobs) + restauração no boot
# (marca queued/running como "error — interrompido por reinício").
VEDIC_JOBS_DIR=data/jobs
VEDIC_JOBS_RESTORE=true

# Object store S3/MinIO (raw + artefatos) — perfil `s3` do compose.
# Desabilitado por padrão (backend local). Para ativar, defina o bucket:
VEDIC_S3_BUCKET=
# MinIO local: http://localhost:9000 (fora do compose) ou http://minio:9000 (entre serviços)
VEDIC_S3_ENDPOINT=http://localhost:9000
VEDIC_S3_PREFIX=
VEDIC_S3_REGION=us-east-1
# Credenciais (ou AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY). Dev: MINIO_ROOT_USER/PASSWORD.
# VEDIC_S3_ACCESS_KEY=
# VEDIC_S3_SECRET_KEY=
# Dev (docker compose --profile s3): console em http://localhost:9001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=vedas
MINIO_ROOT_PASSWORD=troque-em-producao-com-32chars-minimo

# Produção (docker-compose.prod.yml)
POSTGRES_USER=vedas
POSTGRES_PASSWORD=troque-por-senha-forte-alfanumerica-32chars
POSTGRES_DB=vedas
DOMAIN=vedas.local
CORS_ORIGINS=https://vedas.local,http://localhost:8000
VEDAS_IMAGE=ghcr.io/leanderdulac/vedas:latest
VEDAS_TRAIN_IMAGE=ghcr.io/leanderdulac/vedas-train:latest
VEDIC_LOG_FORMAT=json
# HF offline/cache (opcional)
# HF_HOME=artifacts/huggingface
# HF_HUB_OFFLINE=1

# Produção: fail-closed. Sem token, /ask xAI e mídia paga devolvem 503.
# Dev local (instância privada): deixe vazio/false — a chave xAI no servidor autoriza.
# Qualquer uma das flags liga o fail-closed: VEDIC_REQUIRE_GENERATION_TOKEN=true
# ou VEDIC_PUBLIC_API=1 (o compose.prod liga as duas).
# VEDIC_REQUIRE_GENERATION_TOKEN=true

# Cross-Encoder reranker — OFF por padrão (não ligar no deploy).
# Domínio v5 (e v4) passaram o gate no gold de 37 (híbrido 37/37, CE 37/37,
# Nasadiya incl. wrong-number / Devanāgarī / PT ok) mas continua só opt-in.
# Prefira v5 quando os pesos existirem localmente; v4 permanece válido.
# Opt-in: VEDIC_ENABLE_RERANKER=true e VEDIC_RERANKER_MODEL=artifacts/reranker_domain_v5
# Ver docs/reranker_decision.md e docs/ce_promote_gate.md.
VEDIC_ENABLE_RERANKER=false
# Opt-in local (pesos não commitados; aponte para o dir do modelo):
# VEDIC_ENABLE_RERANKER=true
# VEDIC_RERANKER_MODEL=artifacts/reranker_domain_v5
# VEDIC_RERANKER_MODEL=artifacts/reranker_domain_v4
# Genérico HF (não use em prod; regride Nasadiya no gold antigo):
# VEDIC_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
